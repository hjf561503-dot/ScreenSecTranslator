# 代理只用于“按住悬浮球满 3 秒进行一次在线精译”，短按本地模式不需要启动它。
# auto 会优先使用 Gemini，未配置时再尝试 OpenAI。
ONLINE_PROVIDER=auto

# 可选：Gemini API 有受速率限制的免费层。密钥只能放在代理服务端，不能写进 APK。
# 免费层提交的数据可能用于改进 Google 产品；敏感画面不要使用在线精译。
# GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 可选：OpenAI 作为后备提供方。不需要在线精译时可全部留空。
# OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# 可选：团队自己的固定译法，一行一个“英文 = 中文”。
# CUSTOM_GLOSSARY_FILE=./glossary.txt

# 同一台安卓设备上的 Termux 代理可保持 127.0.0.1。
HOST=127.0.0.1
PORT=8787

# 若 HOST 改为 0.0.0.0 或部署到公网，必须设置足够长的随机口令。
APP_SHARED_SECRET=replace_with_a_long_random_secret
